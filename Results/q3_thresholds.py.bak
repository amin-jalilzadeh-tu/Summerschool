"""Q3 figure: parametric epsilon-constraint analysis of the four stakeholder minimums.

All threshold arithmetic is done in INTEGER HUNDREDTHS. Appendix C is published to two
decimals and two configurations sit at exact equality (C8 daylight 0.70, C14 PV 0.70), so
in binary floating point 0.80 + 0.14 = 0.9400000000000001 and C8 fails its own FSI limit by
1e-16. That single artefact changes the reported slack, so the comparison is kept exact.
"""
from pathlib import Path

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

GIVEN = Path("/Users/amin/Documents/4_Learning/Summer school/Digital Twin/data/given/appendix_c.csv")
OUT = Path("/Users/amin/Documents/4_Learning/Summer school/Results")
OUT.mkdir(parents=True, exist_ok=True)

K = ["pv_potential", "daylighting_potential", "relative_compactness", "fsi_performance"]
NICE = {"pv_potential": "PV", "daylighting_potential": "Daylight",
        "relative_compactness": "Compactness", "fsi_performance": "FSI"}
OWNER = {"pv_potential": "municipality", "daylighting_potential": "municipality",
         "relative_compactness": "engineering", "fsi_performance": "client"}

d = pd.read_csv(GIVEN)
A = d[K].to_numpy()
Ai = np.rint(A * 100).astype(int)          # exact hundredths
ids = d.configuration.to_numpy()
B = np.array([70, 70, 75, 80])
P = {"client": [.10, .10, .10, .70], "muni": [.35, .35, .15, .15], "eng": [.15, .15, .55, .15]}

BLUE, RED, GREY, GREEN, AMBER = "#2563eb", "#dc2626", "#a1a1aa", "#059669", "#d97706"

fig = plt.figure(figsize=(16, 6.4))
gs = fig.add_gridspec(1, 3, width_ratios=[1.1, 1, 1.05], wspace=0.30,
                      left=0.055, right=0.985, top=0.79, bottom=0.14)

# --- 1: simultaneous shift -------------------------------------------------------
ax = fig.add_subplot(gs[0, 0])
deltas = np.arange(-5, 7)
counts = [int((Ai >= B + dd).all(1).sum()) for dd in deltas]
cols = [GREY if dd < 0 else (RED if c == 0 else BLUE) for dd, c in zip(deltas, counts)]
ax.bar(deltas, counts, color=cols, width=0.72)
for dd, c in zip(deltas, counts):
    ax.text(dd, c + 0.4, str(c), ha="center", fontsize=8.5,
            color=RED if c == 0 else "#3f3f46", fontweight="bold" if c == 0 else "normal")
ax.axvline(0, color="#18181b", lw=1.1)
ax.text(0.15, 15.6, "as agreed\nin Meeting 4", fontsize=8, color="#18181b")
ax.annotate("empty at +0.06", xy=(6, 0.9), xytext=(3.1, 12.4), fontsize=8.5, color=RED,
            ha="center", arrowprops=dict(arrowstyle="->", color=RED, lw=1.2,
            connectionstyle="arc3,rad=-0.25"))
ax.text(3.1, 10.9, "+0.05 → C1, C6, C21", fontsize=8.5, color="#3f3f46", ha="center")
ax.set_xlabel("all four minimums shifted together (hundredths)", fontsize=9)
ax.set_ylabel("feasible configurations", fontsize=9)
ax.set_title("1 · Six hundredths from infeasibility\nKöksalan II p.11 — vary εᵢ systematically",
             fontsize=10, loc="left")
ax.set_xticks(deltas)
ax.set_xticklabels([f"{dd:+d}" for dd in deltas], fontsize=8)
ax.tick_params(labelsize=8)
for s in ("top", "right"):
    ax.spines[s].set_visible(False)

# --- 2: is each requirement load-bearing? ----------------------------------------
ax = fig.add_subplot(gs[0, 1])
rows = []
for j, k in enumerate(K):
    others = np.all([Ai[:, i] >= B[i] for i in range(4) if i != j], 0)
    uniq = ids[others & (Ai[:, j] < B[j])]
    rows.append((k, len(uniq), list(uniq)))
y = np.arange(4)
vals = [r[1] for r in rows]
cols2 = [GREEN if v > 0 else RED for v in vals]
ax.barh(y, vals, color=cols2, height=0.55)
for i, (k, v, names) in enumerate(rows):
    txt = f"saves {names[0]}" if v else "removes NOTHING the others don't"
    ax.text(v + 0.03, i, txt, va="center", fontsize=9,
            color=RED if v == 0 else "#3f3f46", fontweight="bold" if v == 0 else "normal")
ax.set_yticks(y)
ax.set_yticklabels([f"{NICE[k]} ≥ {B[j]/100:.2f}\n({OWNER[k]})" for j, k in enumerate(K)],
                   fontsize=8.5)
ax.invert_yaxis()
ax.set_xlim(0, 2.6)
ax.set_xticks([0, 1, 2])
ax.set_xlabel("configurations it uniquely eliminates", fontsize=9)
ax.set_title("2 · One requirement does no work\nwhat each removes that the others do not",
             fontsize=10, loc="left")
ax.text(0.99, 2.02, "…and stays non-binding at every\ntightening level from +0.00 to +0.05",
        fontsize=8, color=RED, va="top")
ax.tick_params(labelsize=8)
for s in ("top", "right"):
    ax.spines[s].set_visible(False)

# --- 3: the knife edge -----------------------------------------------------------
ax = fig.add_subplot(gs[0, 2])
ax.axis("off")
scen = [("as agreed", B), ("daylight 0.70 → 0.71", B + np.array([0, 1, 0, 0])),
        ("PV 0.70 → 0.71", B + np.array([1, 0, 0, 0]))]
cells = []
for label, t in scen:
    m = (Ai >= t).all(1)
    sub, Zs = ids[m], A[m]
    w = {k: sub[int(np.argmax(Zs @ np.array(v)))] for k, v in P.items()}
    cells.append([label, str(int(m.sum())), w["client"], w["muni"], w["eng"]])
tbl = ax.table(cellText=cells,
               colLabels=["scenario", "feasible", "client", "municipality", "engineering"],
               cellLoc="center", loc="upper center", colWidths=[0.34, 0.15, 0.16, 0.19, 0.20])
tbl.auto_set_font_size(False)
tbl.set_fontsize(8.5)
tbl.scale(1, 1.75)
for (r, c), cell in tbl.get_celld().items():
    cell.set_edgecolor("#e4e4e7")
    if r == 0:
        cell.set_facecolor("#f4f4f5"); cell.set_text_props(weight="bold", color="#3f3f46")
    elif r == 2 and c == 2:
        cell.set_facecolor("#fee2e2"); cell.set_text_props(weight="bold", color=RED)
    elif r == 3 and c == 4:
        cell.set_facecolor("#fef3c7"); cell.set_text_props(weight="bold", color=AMBER)
ax.set_title("3 · A hundredth decides the client's design\nC8 sits at daylight = 0.70 exactly; C14 at PV = 0.70",
             fontsize=10, loc="left", y=1.02)
ax.text(0.0, 0.46,
        "One hundredth on the municipality's daylight floor — inside the\n"
        "rounding of a two-decimal table — deletes C8, the client's preferred\n"
        "design. Its replacement, C15, is one of the three UNSUPPORTED\n"
        "configurations: no weighted sum can ever select it (Q1).\n\n"
        "The client's own scoring method cannot reach the design it would\n"
        "then want. Meanwhile the engineering team's own requirement\n"
        "changes nothing at all.",
        transform=ax.transAxes, fontsize=8.6, va="top", color="#3f3f46")

fig.suptitle("Q3 · Tightening and relaxing the stakeholder requirements",
             fontsize=13, fontweight="bold", x=0.055, ha="left", y=0.955)
fig.text(0.055, 0.895,
         "Parametric ε-constraint analysis · all threshold comparisons in exact hundredths, "
         "because two designs sit at equality",
         fontsize=9, color="#52525b")
fig.savefig(OUT / "Q3_thresholds.png", dpi=200, facecolor="white")

print("simultaneous:", dict(zip([f"{x:+d}" for x in deltas], counts)))
print("uniquely eliminates:", {NICE[k]: v for k, v, _ in rows})
for row in cells:
    print("  ", row)
print("saved:", OUT / "Q3_thresholds.png")
